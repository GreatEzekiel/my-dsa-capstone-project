    {
      "name": "4. Security: files outside public/ stay private",
      "item": [
        {
          "name": "Climb with ..%2f",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('never 200: the file outside public/ is NOT served', () => pm.expect(pm.response.code).to.be.oneOf([400, 404]));",
                  "pm.test('the project\\'s package.json did not leak', () => pm.expect(pm.response.text()).to.not.include('event-ticketing'));",
                  "pm.test('the secrets did not leak', () => pm.expect(pm.response.text()).to.not.match(/devDependencies|DATABASE_URL|PASSWORD/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/..%2f..%2fpackage.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "..%2f..%2fpackage.json"
              ]
            },
            "description": "The slash is percent-encoded so a naive check does not see it."
          }
        },
        {
          "name": "Climb with %2e%2e",
          "event": [
            {
              "listen": "test",
              "script": {
