                  "pm.test('the project\\'s package.json did not leak', () => pm.expect(pm.response.text()).to.not.include('event-ticketing'));",
                  "pm.test('the secrets did not leak', () => pm.expect(pm.response.text()).to.not.match(/devDependencies|DATABASE_URL|PASSWORD/));"
                ]
              }
